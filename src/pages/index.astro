---
import "../styles/global.css";
import Portrait from "../components/Portrait.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import { Linkedin, Github, User, BookOpen, FileText } from "@lucide/astro";
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="icon" type="image/x-icon" sizes="16x16 32x32 48x48" href="/favicon.ico" />
        <meta name="viewport" content="width=device-width" />
        <meta name="generator" content={Astro.generator} />

        <!-- Prevent flash of wrong theme -->
        <script is:inline>
          (function() {
            const saved = localStorage.getItem('theme');
            if (saved === 'dark' || (!saved && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
              document.documentElement.classList.add('dark');
            }
          })();
        </script>

        <!-- Preload critical resources -->
        <link
            rel="preload"
            href="/Berkeley Mono.woff2"
            as="font"
            type="font/woff2"
            crossorigin
        />
        <link rel="preload" href="/portrait.webp" as="image" />

        <!-- Font loading optimization -->
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            rel="preload"
            href="https://fonts.googleapis.com/css2?family=Lato:wght@400;700&family=Noto+Sans:wght@400;600;700&display=swap"
            as="style"
            onload="this.onload=null;this.rel='stylesheet'"
        />
        <noscript>
            <link
                href="https://fonts.googleapis.com/css2?family=Lato:wght@400;700&family=Noto+Sans:wght@400;600;700&display=swap"
                rel="stylesheet"
            />
        </noscript>

        <title>rioja</title>
        <link rel="alternate" type="application/rss+xml" title="rioja" href="/rss.xml" />

        <!-- Open Graph -->
        <meta property="og:type" content="website" />
        <meta property="og:title" content="rioja" />
        <meta property="og:description" content="Andrew Hall - Technologist and entrepreneur" />
        <meta property="og:url" content="https://rioja.io/" />
        <meta property="og:image" content="https://rioja.io/portrait.webp" />

        <!-- Twitter Card -->
        <meta name="twitter:card" content="summary" />
        <meta name="twitter:title" content="rioja" />
        <meta name="twitter:description" content="Andrew Hall - Technologist and entrepreneur" />
        <meta name="twitter:image" content="https://rioja.io/portrait.webp" />
    </head>
    <body class="font-sans bg-orange-100 text-amber-950 dark:bg-stone-900 dark:text-orange-100">
        <ThemeToggle />
        <main
            class="container max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8 lg:py-16"
        >
            <div class="flex flex-col-reverse sm:flex-row gap-8 items-center mb-12 lg:mb-16 justify-between">
                <div class="flex-1 text-center sm:text-left">
                    <h1
                        class="font-mono max-w-content text-4xl sm:text-5xl lg:text-6xl font-medium leading-tight"
                    >
                        Hello and <span class="text-amber-600 dark:text-amber-400">welcome.</span>
                    </h1>
                    <p class="my-4 text-lg sm:text-xl leading-relaxed">
                        I'm Andrew, a technologist and entrepreneur based in
                        Manchester, UK.
                    </p>
                </div>
                <div class="mx-auto sm:mx-0 rounded-lg overflow-hidden shrink-0">
                    <Portrait />
                </div>
            </div>
            <div
                class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12 mb-12 lg:mb-16"
            >
                <div class="space-y-6">
                    <h2 class="font-mono text-xl sm:text-2xl font-medium">
                        The barrier to entry for <span class="text-amber-600 dark:text-amber-400"
                            >building software</span
                        > has never been lower.
                    </h2>
                    <p class="sm:text-lg leading-relaxed">
                        AI has democratised creation, allowing anyone to
                        prototype ideas instantly. With this, we are witnessing
                        an explosion of "good enough" software.
                    </p>
                    <p class="sm:text-lg leading-relaxed">
                        But in a crowded market, the real challenge isn't just
                        getting something to work: it's building something that
                        scales, survives, and stands out.
                    </p>
                </div>

                <div class="space-y-6">
                    <h2 class="font-mono text-xl sm:text-2xl font-medium">
                        The barrier to <span class="text-amber-600 dark:text-amber-400"
                            >success</span
                        > has never been higher.
                    </h2>
                    <p class="sm:text-lg leading-relaxed">
                        I help founders and organisations bridge the gap between
                        a validated concept and a mature product.
                    </p>
                    <p class="sm:text-lg leading-relaxed">
                        I bring an empiricist's mindset (grounded in systems
                        design, quantitative metrics, and product thinking) to
                        ensure that we are building a scalable product, not just
                        prototypes or vapourware.
                    </p>
                </div>
            </div>
            <div class="text-center mt-4">
                <div
                    class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 max-w-fit mx-auto gap-3"
                >
                    <a
                        href="/blog"
                        class="flex items-center justify-center gap-2 px-6 py-3 bg-amber-600 text-orange-100 font-semibold rounded-lg hover:bg-amber-700 hover:scale-[1.02] active:scale-[0.98] transition-all focus-visible:ring-2 focus-visible:ring-amber-950 focus-visible:ring-offset-2 focus-visible:ring-offset-orange-100 dark:bg-amber-500 dark:text-stone-900 dark:hover:bg-amber-400 dark:focus-visible:ring-orange-100 dark:focus-visible:ring-offset-stone-900 whitespace-nowrap"
                    >
                        <BookOpen size={20} class="shrink-0" />
                        <span>Blog</span>
                    </a>
                    <a
                        href="/about"
                        class="flex items-center justify-center gap-2 px-6 py-3 border-2 border-amber-600 text-amber-700 font-semibold rounded-lg hover:bg-amber-600 hover:text-orange-100 hover:scale-[1.02] active:scale-[0.98] transition-all focus-visible:ring-2 focus-visible:ring-amber-950 focus-visible:ring-offset-2 focus-visible:ring-offset-orange-100 dark:border-amber-400 dark:text-amber-400 dark:hover:bg-amber-400 dark:hover:text-stone-900 dark:focus-visible:ring-orange-100 dark:focus-visible:ring-offset-stone-900 whitespace-nowrap"
                    >
                        <User size={20} class="shrink-0" />
                        <span>About me</span>
                    </a>
                    <a
                        href="https://curvit.me/@andytango"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="flex items-center justify-center gap-2 px-6 py-3 border-2 border-amber-600 text-amber-700 font-semibold rounded-lg hover:bg-amber-600 hover:text-orange-100 hover:scale-[1.02] active:scale-[0.98] transition-all focus-visible:ring-2 focus-visible:ring-amber-950 focus-visible:ring-offset-2 focus-visible:ring-offset-orange-100 dark:border-amber-400 dark:text-amber-400 dark:hover:bg-amber-400 dark:hover:text-stone-900 dark:focus-visible:ring-orange-100 dark:focus-visible:ring-offset-stone-900 whitespace-nowrap"
                    >
                        <FileText size={20} class="shrink-0" />
                        <span>CV / Resume</span>
                    </a>
                    <a
                        href="https://www.linkedin.com/in/a-hall2"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="flex items-center justify-center gap-2 px-6 py-3 border-2 border-amber-600 text-amber-700 font-semibold rounded-lg hover:bg-amber-600 hover:text-orange-100 hover:scale-[1.02] active:scale-[0.98] transition-all focus-visible:ring-2 focus-visible:ring-amber-950 focus-visible:ring-offset-2 focus-visible:ring-offset-orange-100 dark:border-amber-400 dark:text-amber-400 dark:hover:bg-amber-400 dark:hover:text-stone-900 dark:focus-visible:ring-orange-100 dark:focus-visible:ring-offset-stone-900 whitespace-nowrap"
                    >
                        <Linkedin size={20} class="shrink-0" />
                        <span>LinkedIn</span>
                    </a>
                    <a
                        href="https://github.com/andytango"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="flex items-center justify-center gap-2 px-6 py-3 border-2 border-amber-600 text-amber-700 font-semibold rounded-lg hover:bg-amber-600 hover:text-orange-100 hover:scale-[1.02] active:scale-[0.98] transition-all focus-visible:ring-2 focus-visible:ring-amber-950 focus-visible:ring-offset-2 focus-visible:ring-offset-orange-100 dark:border-amber-400 dark:text-amber-400 dark:hover:bg-amber-400 dark:hover:text-stone-900 dark:focus-visible:ring-orange-100 dark:focus-visible:ring-offset-stone-900 whitespace-nowrap"
                    >
                        <Github size={20} class="shrink-0" />
                        <span>GitHub</span>
                    </a>
                </div>
            </div>
        </main>
        <!-- Cloudflare Web Analytics -->
        <script
            defer
            src="https://static.cloudflareinsights.com/beacon.min.js"
            data-cf-beacon='{"token": "9dde7d572a9c4cd6b72afe90def4d74f"}'
        ></script><!-- End Cloudflare Web Analytics -->
    </body>
</html>
