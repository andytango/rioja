---
import { getCollection } from "astro:content";
import Layout from "../../components/Layout.astro";
import PageHeading from "../../components/PageHeading.astro";
import BackLink from "../../components/BackLink.astro";
import { Rss } from "@lucide/astro";

const allPosts = await getCollection("blog", ({ data }) => {
    return data.draft !== true;
});

// Sort posts by date, newest first
const sortedPosts = allPosts.sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<Layout
    title="Blog - rioja"
    description="Thoughts on economics, technology, and strategy."
>
    <main class="container max-w-6xl mx-auto px-4 py-12">
        <!-- Header -->
        <header class="mb-8">
            <nav class="mb-8">
                <BackLink href="/" text="Home" />
            </nav>
            <div class="flex items-center justify-between">
                <PageHeading text="Blog" />
                <a
                    href="/rss.xml"
                    class="flex items-center gap-1.5 text-sm font-mono text-amber-600 dark:text-amber-400 hover:text-amber-700 dark:hover:text-amber-300 transition-colors"
                    title="RSS feed"
                >
                    <Rss size={16} />
                    <span>RSS</span>
                </a>
            </div>
        </header>

        <!-- Blog Posts List -->
        <div class="space-y-8">
            {
                sortedPosts.map((post) => (
                    <article class="border-b border-amber-950/10 dark:border-orange-100/10 pb-8 last:border-0">
                        <a href={`/blog/${post.slug}`} class="group block rounded -mx-4 px-4 py-2 hover:bg-amber-950/5 dark:hover:bg-orange-100/5 transition-colors focus-visible:ring-2 focus-visible:ring-amber-950 dark:focus-visible:ring-orange-100 focus-visible:ring-offset-4 focus-visible:ring-offset-orange-100 dark:focus-visible:ring-offset-stone-900">
                            <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1 sm:gap-2 mb-4">
                                <h2 class="text-2xl font-mono font-semibold text-amber-950 dark:text-orange-100 group-hover:text-amber-600 dark:group-hover:text-amber-400 transition-colors group-hover:underline underline-offset-4">
                                    {post.data.title}
                                </h2>
                                <time
                                    datetime={post.data.pubDate.toISOString()}
                                    class="text-sm font-mono text-amber-600 dark:text-amber-400 shrink-0 mt-1 sm:mt-0"
                                >
                                    {post.data.pubDate.toLocaleDateString(
                                        "en-US",
                                        {
                                            year: "numeric",
                                            month: "short",
                                            day: "numeric",
                                        },
                                    )}
                                </time>
                            </div>
                            <p class="text-amber-950/80 dark:text-orange-100/80 leading-relaxed mb-4">
                                {post.data.description}
                            </p>
                            {post.data.tags.length > 0 && (
                                <div class="flex gap-3">
                                    {post.data.tags.map((tag) => (
                                        <span class="text-xs font-mono text-amber-600 dark:text-amber-400 px-2 py-0.5 border border-amber-600/30 dark:border-amber-400/30 rounded-full">
                                            {tag}
                                        </span>
                                    ))}
                                </div>
                            )}
                        </a>
                    </article>
                ))
            }
        </div>

        {
            sortedPosts.length === 0 && (
                <p class="text-center text-amber-600 dark:text-amber-400 py-12">
                    No posts yet. Check back soon!
                </p>
            )
        }
    </main>
</Layout>
