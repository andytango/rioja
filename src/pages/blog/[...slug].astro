---
import { getCollection } from 'astro:content';
import Layout from '../../components/Layout.astro';
import BackLink from '../../components/BackLink.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => {
    return data.draft !== true;
  });

  return posts.map((post) => ({
    params: { slug: post.slug },
    props: post,
  }));
}

const post = Astro.props;
const { Content } = await post.render();
---

<Layout
  title={`${post.data.title} - rioja`}
  description={post.data.description}
>
  <main class="max-w-3xl mx-auto px-4 py-12">
      <!-- Navigation -->
      <nav class="mb-12">
        <div class="font-mono text-sm">
          <BackLink href="/blog" text="Blog" />
        </div>
      </nav>

      <!-- Article Header -->
      <article>
        <header class="mb-12 pb-8 border-b border-amber-950/10">
          <h1 class="text-4xl sm:text-5xl font-mono font-medium mb-6">
            {post.data.title}
          </h1>
          <div class="font-mono text-sm text-amber-600">
            <time datetime={post.data.pubDate.toISOString()}>
              {post.data.pubDate.toLocaleDateString('en-US', {
                year: 'numeric',
                month: 'short',
                day: 'numeric'
              })}
            </time>
          </div>
        </header>

        <!-- Article Content -->
        <div class="prose prose-lg max-w-none
          prose-headings:font-mono prose-headings:text-amber-950 prose-headings:font-medium
          prose-h2:text-xl prose-h2:mt-16 prose-h2:mb-6
          prose-h3:text-lg prose-h3:mt-10 prose-h3:mb-4
          prose-p:text-amber-950/90 prose-p:leading-relaxed prose-p:mb-6
          prose-a:text-amber-600 prose-a:underline hover:prose-a:text-amber-950
          prose-strong:text-amber-950 prose-strong:font-semibold
          prose-ul:list-disc prose-ul:ml-6 prose-ul:mb-6
          prose-ol:list-decimal prose-ol:ml-6 prose-ol:mb-6
          prose-li:text-amber-950/90 prose-li:mb-2
          prose-code:font-mono prose-code:text-amber-600 prose-code:text-sm
          prose-pre:bg-amber-950 prose-pre:text-amber-50 prose-pre:font-mono prose-pre:mb-6
          prose-blockquote:border-l-2 prose-blockquote:border-amber-600 prose-blockquote:pl-4 prose-blockquote:italic prose-blockquote:text-amber-950/80 prose-blockquote:mb-6
        ">
          <Content />
        </div>

        <!-- Updated Date -->
        {post.data.updatedDate && (
          <footer class="mt-12 pt-6 border-t border-amber-950/10">
            <p class="text-sm font-mono text-amber-600">
              Updated: {post.data.updatedDate.toLocaleDateString('en-US', {
                year: 'numeric',
                month: 'short',
                day: 'numeric'
              })}
            </p>
          </footer>
        )}
      </article>

      <!-- Back to Blog -->
      <div class="mt-16 pt-8 border-t border-amber-950/10 font-mono text-sm">
        <BackLink href="/blog" text="Back to all posts" />
      </div>
    </main>
  </Layout>
